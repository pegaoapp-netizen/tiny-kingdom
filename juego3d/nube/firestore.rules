rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tropas de un refuerzo: los 4 tipos, números enteros de 0 a 300
    function tropasValidas(t) {
      return t.keys().hasOnly(['espadachin', 'caballeria', 'arquero', 'guardian'])
        && t.keys().hasAll(['espadachin', 'caballeria', 'arquero', 'guardian'])
        && t.espadachin is int && t.espadachin >= 0 && t.espadachin <= 300
        && t.caballeria is int && t.caballeria >= 0 && t.caballeria <= 300
        && t.arquero is int && t.arquero >= 0 && t.arquero <= 300
        && t.guardian is int && t.guardian >= 0 && t.guardian <= 300;
    }

    // Partida privada: cada jugador solo puede leer y escribir SU propia partida.
    match /jugadores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['usuario', 'partida', 'actualizado', 'version'])
        && request.resource.data.partida is string
        && request.resource.data.partida.size() < 20000
        && request.resource.data.actualizado is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Aldea pública en el mapa del mundo: todos los jugadores con cuenta la ven,
    // pero solo su dueño la puede cambiar.
    match /aldeas/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'nivel', 'poder', 'x', 'y', 'alianza', 'actualizado', 'escudo', 'defensa'])
        && (!('escudo' in request.resource.data) || request.resource.data.escudo is int)
        && (!('defensa' in request.resource.data) || (request.resource.data.defensa is int && request.resource.data.defensa >= 0 && request.resource.data.defensa <= 100000000))
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.nivel is int && request.resource.data.nivel >= 1 && request.resource.data.nivel <= 100000
        && request.resource.data.poder is int && request.resource.data.poder >= 0 && request.resource.data.poder <= 1000000000
        && request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x < 100
        && request.resource.data.y is int && request.resource.data.y >= 0 && request.resource.data.y < 100
        && request.resource.data.actualizado is int
        && (request.resource.data.alianza == null
            || (request.resource.data.alianza is string
                && exists(/databases/$(database)/documents/alianzas/$(request.resource.data.alianza))));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Alianzas: el id es la etiqueta (2 a 4 letras o números, en mayúsculas).
    // Cualquiera con cuenta puede crear una (si la etiqueta está libre) y verlas.
    // Solo el líder puede borrarla. Nadie la puede modificar después.
    match /alianzas/{tag} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && tag.matches('^[A-Z0-9]{2,4}$')
        && request.resource.data.keys().hasOnly(['nombre', 'tag', 'lider', 'liderNombre', 'creada'])
        && request.resource.data.tag == tag
        && request.resource.data.lider == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 24
        && request.resource.data.liderNombre is string && request.resource.data.liderNombre.size() <= 30
        && request.resource.data.creada is int;
      allow delete: if request.auth != null && resource.data.lider == request.auth.uid;
      allow update: if false;
    }

    // Ataques entre jugadores: el atacante crea el reporte; el defensor lo lee y lo marca como visto.
    // No se puede atacar a uno mismo, ni a un reino protegido, ni llevarse más de 5.000 de cada recurso.
    // Casillas del mapa del mundo conquistadas: id 'x_y' (0..39). El dueño es siempre quien escribe.
    match /casillas/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id.matches('^[0-9]{1,2}_[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['dueno', 'nombre', 'alianza', 'fecha'])
        && request.resource.data.dueno == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30
        && request.resource.data.alianza is string && request.resource.data.alianza.size() <= 6
        && request.resource.data.fecha is int;
      allow delete: if request.auth != null && resource.data.dueno == request.auth.uid;
    }
    match /ataques/{id} {
      allow read: if request.auth != null
        && (resource.data.defensor == request.auth.uid || resource.data.atacante == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['atacante', 'atacanteNombre', 'defensor', 'defensorNombre', 'gano', 'botin', 'fuerza', 'defensa', 'fecha', 'visto'])
        && request.resource.data.atacante == request.auth.uid
        && request.resource.data.defensor is string
        && request.resource.data.defensor != request.auth.uid
        && request.resource.data.atacanteNombre is string && request.resource.data.atacanteNombre.size() <= 30
        && request.resource.data.defensorNombre is string && request.resource.data.defensorNombre.size() <= 30
        && request.resource.data.gano is bool
        && request.resource.data.visto == false
        && request.resource.data.fecha is int
        && request.resource.data.fuerza is int && request.resource.data.defensa is int
        && request.resource.data.botin.keys().hasOnly(['oro', 'comida', 'madera', 'piedra'])
        && request.resource.data.botin.oro is int && request.resource.data.botin.oro >= 0 && request.resource.data.botin.oro <= 5000
        && request.resource.data.botin.comida is int && request.resource.data.botin.comida >= 0 && request.resource.data.botin.comida <= 5000
        && request.resource.data.botin.madera is int && request.resource.data.botin.madera >= 0 && request.resource.data.botin.madera <= 5000
        && request.resource.data.botin.piedra is int && request.resource.data.botin.piedra >= 0 && request.resource.data.botin.piedra <= 5000
        && exists(/databases/$(database)/documents/aldeas/$(request.resource.data.defensor))
        && get(/databases/$(database)/documents/aldeas/$(request.resource.data.defensor)).data.get('escudo', 0) < request.time.toMillis();
      allow update: if request.auth != null && resource.data.defensor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
        && request.resource.data.visto == true;
      allow delete: if false;
    }

    // Refuerzos entre aliados: solo entre jugadores de la MISMA hermandad.
    // El que envía crea el documento y lo puede borrar (retirar). El que recibe solo puede
    // bajar el número de tropas (las que murieron) o marcarlo como devuelto.
    match /refuerzos/{id} {
      allow read: if request.auth != null
        && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'deNombre', 'para', 'paraNombre', 'tropas', 'alianza', 'fecha', 'devuelto'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string
        && request.resource.data.para != request.auth.uid
        && request.resource.data.deNombre is string && request.resource.data.deNombre.size() <= 30
        && request.resource.data.paraNombre is string && request.resource.data.paraNombre.size() <= 30
        && request.resource.data.fecha is int
        && request.resource.data.devuelto == false
        && request.resource.data.alianza is string
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.alianza == request.resource.data.alianza
        && get(/databases/$(database)/documents/aldeas/$(request.resource.data.para)).data.alianza == request.resource.data.alianza
        && tropasValidas(request.resource.data.tropas)
        && (request.resource.data.tropas.espadachin + request.resource.data.tropas.caballeria + request.resource.data.tropas.arquero + request.resource.data.tropas.guardian) > 0;
      allow update: if request.auth != null && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tropas', 'devuelto'])
        && request.resource.data.devuelto is bool
        && tropasValidas(request.resource.data.tropas)
        && request.resource.data.tropas.espadachin <= resource.data.tropas.espadachin
        && request.resource.data.tropas.caballeria <= resource.data.tropas.caballeria
        && request.resource.data.tropas.arquero <= resource.data.tropas.arquero
        && request.resource.data.tropas.guardian <= resource.data.tropas.guardian;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
    }

    // Pedidos de refuerzo: uno por jugador. Los ven los demás jugadores; solo el dueño lo cambia.
    match /pedidos/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'alianza', 'fecha'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.alianza is string
        && exists(/databases/$(database)/documents/alianzas/$(request.resource.data.alianza))
        && request.resource.data.fecha is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
