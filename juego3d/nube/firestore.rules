rules_version = '2';
// reglas v7.92: compras/{id} (las crea solo el servidor; el jugador las marca como cobradas)
service cloud.firestore {
  match /databases/{database}/documents {

    // Tropas de un refuerzo: los 4 tipos, números enteros de 0 a 300
    function tropasValidas(t) {
      return t.keys().hasOnly(['espadachin', 'caballeria', 'arquero', 'guardian'])
        && t.keys().hasAll(['espadachin', 'caballeria', 'arquero', 'guardian'])
        && t.espadachin is int && t.espadachin >= 0 && t.espadachin <= 300
        && t.caballeria is int && t.caballeria >= 0 && t.caballeria <= 300
        && t.arquero is int && t.arquero >= 0 && t.arquero <= 300
        && t.guardian is int && t.guardian >= 0 && t.guardian <= 300;
    }

    // Partida privada: cada jugador solo puede leer y escribir SU propia partida.
    // v7.92: compras de dinero real. Solo las crea el servidor (Cloud Functions con el recibo verificado);
    // el jugador lee las suyas y solo puede marcarlas como cobradas (una vez).
    match /compras/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && resource.data.cobrada == false && request.resource.data.cobrada == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobrada', 'cobradaEn']);
    }
    // v7.85: copia de seguridad del reino (solo su dueño la lee y la escribe)
    match /respaldos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['partida', 'progreso', 'actualizado'])
        && request.resource.data.partida is string && request.resource.data.partida.size() < 900000
        && request.resource.data.progreso is int && request.resource.data.actualizado is int;
    }
    match /jugadores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['usuario', 'partida', 'actualizado', 'version'])
        && request.resource.data.partida is string
        && request.resource.data.partida.size() < 900000 // v7.40: antes 20000 y los reinos grandes no se guardaban en la nube
        && request.resource.data.actualizado is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Aldea pública en el mapa del mundo: todos los jugadores con cuenta la ven,
    // pero solo su dueño la puede cambiar.
    match /aldeas/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'nivel', 'poder', 'x', 'y', 'alianza', 'actualizado', 'escudo', 'defensa', 'espia', 'mapa', 'kp', 'kpt', 'kps'])
        && (!('kp' in request.resource.data) || (request.resource.data.kp is int && request.resource.data.kp >= 0 && request.resource.data.kp <= 1000000000000000))
        && (!('kpt' in request.resource.data) || (request.resource.data.kpt is int && request.resource.data.kpt >= 0 && request.resource.data.kpt <= 1000000000000000))
        && (!('kps' in request.resource.data) || request.resource.data.kps is int)
        && (!('mapa' in request.resource.data) || request.resource.data.mapa is int)
        && (!('espia' in request.resource.data) || (request.resource.data.espia is map && request.resource.data.espia.size() <= 8))
        && (!('escudo' in request.resource.data) || request.resource.data.escudo is int)
        && (!('defensa' in request.resource.data) || (request.resource.data.defensa is int && request.resource.data.defensa >= 0 && request.resource.data.defensa <= 100000000))
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.nivel is int && request.resource.data.nivel >= 1 && request.resource.data.nivel <= 100000
        && request.resource.data.poder is int && request.resource.data.poder >= 0 && request.resource.data.poder <= 1000000000000000
        && request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x < 300
        && request.resource.data.y is int && request.resource.data.y >= 0 && request.resource.data.y < 300
        && request.resource.data.actualizado is int
        && (request.resource.data.alianza == null
            || (request.resource.data.alianza is string
                && exists(/databases/$(database)/documents/alianzas/$(request.resource.data.alianza))));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Alianzas: el id es la etiqueta (2 a 4 letras o números, en mayúsculas).
    // Cualquiera con cuenta puede crear una (si la etiqueta está libre) y verlas.
    // Solo el líder puede borrarla. Nadie la puede modificar después.
    // v6.34: torneo semanal. Cada jugador escribe solo sus puntos de la semana que corre.
    match /torneos/{semana}/puntos/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && semana.matches('^[0-9]{4,6}$')
        && request.resource.data.keys().hasOnly(['nombre', 'puntos', 'alianza', 'actualizado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.puntos is int && request.resource.data.puntos >= 0 && request.resource.data.puntos <= 100000000
        && (request.resource.data.alianza == null || request.resource.data.alianza is string)
        && request.resource.data.actualizado is int;
    }
    // v7.76: torneo de temporada (14 días). Cada jugador escribe solo sus puntos.
    match /temporadas/{temp}/puntos/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && temp.matches('^[0-9]{3,6}$')
        && request.resource.data.keys().hasOnly(['nombre', 'puntos', 'liq', 'alianza', 'actualizado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.puntos is int && request.resource.data.puntos >= 0 && request.resource.data.puntos <= 1000000000000
        && request.resource.data.liq is int && request.resource.data.liq >= 0 && request.resource.data.liq <= request.resource.data.puntos
        && (request.resource.data.alianza == null || request.resource.data.alianza is string)
        && request.resource.data.actualizado is int;
    }
    match /alianzas/{tag} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && tag.matches('^[A-Z0-9]{2,4}$')
        && request.resource.data.keys().hasOnly(['nombre', 'tag', 'lider', 'liderNombre', 'creada', 'idioma', 'descripcion'])
        && request.resource.data.tag == tag
        && request.resource.data.lider == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 24
        && request.resource.data.liderNombre is string && request.resource.data.liderNombre.size() <= 30
        && request.resource.data.creada is int;
      allow delete: if request.auth != null && resource.data.lider == request.auth.uid;
      // solo el canciller (líder) cambia el idioma, el anuncio, los puestos (vicecanciller, mariscal, oficial) y puede ceder la cancillería
      // v7.17: antes solo dejaba idioma y anuncio, por eso no se podía nombrar un vicecanciller ni ceder la cancillería
      allow update: if request.auth != null && resource.data.lider == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['idioma', 'descripcion', 'rangos', 'lider', 'liderNombre', 'bonif', 'ma'])
        && (!('ma' in request.resource.data) || (request.resource.data.ma is int && request.resource.data.ma >= 0))
        && (!('bonif' in request.resource.data) || (request.resource.data.bonif is map && request.resource.data.bonif.size() <= 10))
        && (!('idioma' in request.resource.data) || (request.resource.data.idioma is string && request.resource.data.idioma.size() <= 12))
        && (!('descripcion' in request.resource.data) || (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 120))
        && (!('rangos' in request.resource.data) || (request.resource.data.rangos is map && request.resource.data.rangos.size() <= 200))
        && request.resource.data.lider is string && request.resource.data.lider.size() > 0
        && request.resource.data.liderNombre is string && request.resource.data.liderNombre.size() <= 30;
      // v7.99: cualquier miembro dona: solo suben la experiencia (xp) y el Mérito de Alianza (ma), poco a poco
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/aldeas/$(request.auth.uid))
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.get('alianza', '') == tag
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'ma'])
        && request.resource.data.xp is int && request.resource.data.xp > resource.data.get('xp', 0) && request.resource.data.xp <= resource.data.get('xp', 0) + 5000
        && request.resource.data.ma is int && request.resource.data.ma >= resource.data.get('ma', 0) && request.resource.data.ma <= resource.data.get('ma', 0) + 5000;
    }

    // Ataques entre jugadores: el atacante crea el reporte; el defensor lo lee y lo marca como visto.
    // No se puede atacar a uno mismo, ni a un reino protegido, ni llevarse más de 5.000 de cada recurso.
    // Casillas del mapa del mundo conquistadas: id 'x_y' (0..39). El dueño es siempre quien escribe.
    match /casillas/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id.matches('^[0-9]{1,3}_[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['dueno', 'nombre', 'alianza', 'fecha', 'mapa'])
        && request.resource.data.dueno == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30
        && request.resource.data.alianza is string && request.resource.data.alianza.size() <= 6
        && request.resource.data.fecha is int;
      allow delete: if request.auth != null && resource.data.dueno == request.auth.uid;
    }
    // Ataques con marcha: se crean al salir, se resuelven al llegar (lo hace el defensor o el atacante, una sola vez)
    function botinOk(b) {
      return b.keys().hasOnly(['oro', 'comida', 'madera', 'piedra'])
        && b.oro is int && b.oro >= 0 && b.oro <= 65000 && b.comida is int && b.comida >= 0 && b.comida <= 65000
        && b.madera is int && b.madera >= 0 && b.madera <= 65000 && b.piedra is int && b.piedra >= 0 && b.piedra <= 65000;
    }
    // v7.39: el Canciller (líder) de una alianza ve los ataques de sus miembros y contra ellos
    function esMiembroAl(tag) {
      return tag is string && tag.size() >= 2 && tag.size() <= 6
        && exists(/databases/$(database)/documents/aldeas/$(request.auth.uid))
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.get('alianza', '') == tag;
    }
    function esCanciller(tag) {
      return tag is string && tag.size() >= 2 && tag.size() <= 6
        && get(/databases/$(database)/documents/alianzas/$(tag)).data.lider == request.auth.uid;
    }
    match /ataques/{id} {
      allow read: if request.auth != null
        && (resource.data.defensor == request.auth.uid || resource.data.atacante == request.auth.uid
          || esCanciller(resource.data.get('alD', '')) || esCanciller(resource.data.get('alA', ''))
          || esMiembroAl(resource.data.get('alD', '')) || esMiembroAl(resource.data.get('alA', ''))); // v7.99: Muro › Informes
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['atacante', 'atacanteNombre', 'defensor', 'defensorNombre', 'gano', 'botin', 'fuerza', 'defensa', 'fecha', 'visto', 'llega', 'resuelto', 'cobrado', 'bajas', 'alA', 'alD', 'dia'])
        && request.resource.data.atacante == request.auth.uid
        && (!('dia' in request.resource.data) || (request.resource.data.dia is string && request.resource.data.dia.size() == 10))
        && (!('alA' in request.resource.data) || (request.resource.data.alA is string
            && request.resource.data.alA == get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.get('alianza', '')))
        && (!('alD' in request.resource.data) || (request.resource.data.alD is string
            && request.resource.data.alD == get(/databases/$(database)/documents/aldeas/$(request.resource.data.defensor)).data.get('alianza', '')))
        && request.resource.data.defensor is string
        && request.resource.data.defensor != request.auth.uid
        && request.resource.data.atacanteNombre is string && request.resource.data.atacanteNombre.size() <= 30
        && request.resource.data.defensorNombre is string && request.resource.data.defensorNombre.size() <= 30
        && request.resource.data.gano == false && request.resource.data.visto == false
        && request.resource.data.resuelto == false && request.resource.data.cobrado == false && request.resource.data.bajas == 0
        && request.resource.data.fecha is int
        && request.resource.data.fuerza is int && request.resource.data.defensa is int
        && request.resource.data.llega is int
        && request.resource.data.llega >= request.time.toMillis() + 20000
        && request.resource.data.llega <= request.time.toMillis() + 900000
        && botinOk(request.resource.data.botin)
        && exists(/databases/$(database)/documents/aldeas/$(request.resource.data.defensor))
        && get(/databases/$(database)/documents/aldeas/$(request.resource.data.defensor)).data.get('escudo', 0) < request.time.toMillis();
      allow update: if request.auth != null && (
        (resource.data.get('resuelto', true) == false
          && request.time.toMillis() >= resource.data.llega
          && (resource.data.defensor == request.auth.uid || resource.data.atacante == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gano', 'botin', 'resuelto', 'defensa', 'bajas'])
          && request.resource.data.resuelto == true
          && request.resource.data.gano is bool
          && request.resource.data.bajas is number && request.resource.data.bajas >= 0 && request.resource.data.bajas <= 1
          && request.resource.data.defensa is int
          && botinOk(request.resource.data.botin)
          && request.resource.data.botin.oro <= resource.data.botin.oro && request.resource.data.botin.comida <= resource.data.botin.comida
          && request.resource.data.botin.madera <= resource.data.botin.madera && request.resource.data.botin.piedra <= resource.data.botin.piedra)
        // v7.19: el atacante acelera su marcha: solo puede adelantar la llegada, nunca a antes de ahora + 15 s
        || (resource.data.atacante == request.auth.uid
          && resource.data.get('resuelto', true) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['llega'])
          && request.resource.data.llega is int
          && request.resource.data.llega < resource.data.llega
          && request.resource.data.llega >= request.time.toMillis() + 15000)
        // el defensor se muda con un portal antes de que llegue (o el atacante cancela su marcha): se cancela sin botín ni bajas
        || ((resource.data.defensor == request.auth.uid || resource.data.atacante == request.auth.uid)
          && resource.data.get('resuelto', true) == false
          && request.time.toMillis() < resource.data.llega
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado', 'resuelto', 'gano', 'bajas', 'defensa', 'botin'])
          && request.resource.data.cancelado == true && request.resource.data.resuelto == true && request.resource.data.gano == false
          && request.resource.data.bajas == 0 && request.resource.data.defensa == 0
          && request.resource.data.botin.oro == 0 && request.resource.data.botin.comida == 0
          && request.resource.data.botin.madera == 0 && request.resource.data.botin.piedra == 0)
        || (resource.data.defensor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
          && request.resource.data.visto == true)
        || (resource.data.atacante == request.auth.uid && resource.data.get('resuelto', true) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobrado'])
          && request.resource.data.cobrado == true)
      );
      allow delete: if false;
    }

    // Refuerzos entre aliados: solo entre jugadores de la MISMA hermandad.
    // El que envía crea el documento y lo puede borrar (retirar). El que recibe solo puede
    // bajar el número de tropas (las que murieron) o marcarlo como devuelto.
    // Envíos de recursos entre miembros de la misma hermandad (máximo 5000 de cada uno por envío)
    function recursoValido(v) { return v is int && v >= 0 && v <= 100000000; } // v7.99: carretas masivas
    match /envios/{id} {
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'deNombre', 'para', 'recursos', 'alianza', 'fecha', 'llega', 'carretas'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string && request.resource.data.para != request.auth.uid
        && request.resource.data.deNombre is string && request.resource.data.deNombre.size() <= 30
        && request.resource.data.fecha is int
        // las carretas tardan en llegar (como mucho 2 horas)
        && (!('llega' in request.resource.data) || (request.resource.data.llega is int && request.resource.data.llega <= request.time.toMillis() + 7200000))
        && request.resource.data.alianza is string
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.alianza == request.resource.data.alianza
        && get(/databases/$(database)/documents/aldeas/$(request.resource.data.para)).data.alianza == request.resource.data.alianza
        && request.resource.data.recursos.keys().hasOnly(['oro', 'comida', 'madera', 'piedra', 'hierro'])
        && recursoValido(request.resource.data.recursos.oro) && recursoValido(request.resource.data.recursos.comida)
        && recursoValido(request.resource.data.recursos.madera) && recursoValido(request.resource.data.recursos.piedra);
      allow delete: if request.auth != null && resource.data.para == request.auth.uid;
    }
    // Chat: canal global para todos y un canal por hermandad (al_TAG) solo para sus miembros
    function enCanal(canal) {
      return canal == 'global'
        || (canal.matches('^pv_[A-Za-z0-9]+_[A-Za-z0-9]+$') && (canal.split('_')[1] == request.auth.uid || canal.split('_')[2] == request.auth.uid))
        || (canal.matches('^al_[A-Z0-9]{2,4}$')
        && exists(/databases/$(database)/documents/aldeas/$(request.auth.uid))
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.alianza == canal.split('_')[1]);
    }
    match /canales/{canal}/mensajes/{id} {
      allow read: if request.auth != null && enCanal(canal);
      allow create: if request.auth != null && enCanal(canal)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'texto', 'fecha'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 200
        && request.resource.data.fecha is int
        && request.resource.data.fecha > request.time.toMillis() - 60000 && request.resource.data.fecha < request.time.toMillis() + 60000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Chat privado: lista de conversaciones de cada jugador. El dueño lee, marca y borra; el otro solo deja aviso de su mensaje.
    match /privados/{dest}/conv/{de} {
      allow read, delete: if request.auth != null && request.auth.uid == dest;
      allow create, update: if request.auth != null && (request.auth.uid == dest || request.auth.uid == de)
        && request.resource.data.keys().hasOnly(['nombre', 'texto', 'fecha', 'nuevo'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 200
        && request.resource.data.fecha is int && request.resource.data.nuevo is bool;
    }
    // Reportes de mensajes: solo se crean (se revisan desde la consola de Firebase)
    match /reportes/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'contra', 'contraNombre', 'texto', 'canal', 'mensaje', 'fecha'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.contra is string && request.resource.data.contraNombre is string && request.resource.data.contraNombre.size() <= 30
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 200
        && request.resource.data.canal is string && request.resource.data.canal.size() <= 10
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 40
        && request.resource.data.fecha is int;
      allow read, update, delete: if false;
    }
    match /refuerzos/{id} {
      allow read: if request.auth != null
        && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'deNombre', 'para', 'paraNombre', 'tropas', 'alianza', 'fecha', 'devuelto', 'heroe'])
        && (!('heroe' in request.resource.data) || (request.resource.data.heroe is string && request.resource.data.heroe.size() <= 30))
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string
        && request.resource.data.para != request.auth.uid
        && request.resource.data.deNombre is string && request.resource.data.deNombre.size() <= 30
        && request.resource.data.paraNombre is string && request.resource.data.paraNombre.size() <= 30
        && request.resource.data.fecha is int
        && request.resource.data.devuelto == false
        && request.resource.data.alianza is string
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.alianza == request.resource.data.alianza
        && get(/databases/$(database)/documents/aldeas/$(request.resource.data.para)).data.alianza == request.resource.data.alianza
        && tropasValidas(request.resource.data.tropas)
        && (request.resource.data.tropas.espadachin + request.resource.data.tropas.caballeria + request.resource.data.tropas.arquero + request.resource.data.tropas.guardian) > 0;
      allow update: if request.auth != null && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tropas', 'devuelto'])
        && request.resource.data.devuelto is bool
        && tropasValidas(request.resource.data.tropas)
        && request.resource.data.tropas.espadachin <= resource.data.tropas.espadachin
        && request.resource.data.tropas.caballeria <= resource.data.tropas.caballeria
        && request.resource.data.tropas.arquero <= resource.data.tropas.arquero
        && request.resource.data.tropas.guardian <= resource.data.tropas.guardian;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
    }

    // Pedidos de la alianza (refuerzos y recursos). El dueño los crea y quita;
    // los compañeros de la MISMA alianza solo pueden sumar lo que donan y su nombre.
    match /pedidos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (id == request.auth.uid || id == request.auth.uid + '_t' || id == request.auth.uid + '_r')
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'alianza', 'fecha', 'tipo', 'motivo', 'recurso', 'cantidad', 'recibido', 'donantes', 'recursos', 'recibidos', 'destino'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30
        && request.resource.data.alianza is string
        && exists(/databases/$(database)/documents/alianzas/$(request.resource.data.alianza))
        && request.resource.data.fecha is int
        && (!('cantidad' in request.resource.data) || (request.resource.data.cantidad is int && request.resource.data.cantidad >= 1 && request.resource.data.cantidad <= 250000000))
        && (!('recibido' in request.resource.data) || (request.resource.data.recibido is int && request.resource.data.recibido >= 0))
        && (!('recursos' in request.resource.data) || (request.resource.data.recursos is map && request.resource.data.recursos.keys().hasOnly(['oro', 'comida', 'madera', 'piedra', 'hierro'])))
        && (!('recibidos' in request.resource.data) || request.resource.data.recibidos is map)
        && (!('destino' in request.resource.data) || (request.resource.data.destino is map && request.resource.data.destino.keys().hasOnly(['n', 'x', 'y'])));
      allow update: if request.auth != null && resource.data.get('uid', id) != request.auth.uid
        && exists(/databases/$(database)/documents/aldeas/$(request.auth.uid))
        && get(/databases/$(database)/documents/aldeas/$(request.auth.uid)).data.alianza == resource.data.alianza
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recibido', 'donantes', 'recibidos'])
        && request.resource.data.recibido is int
        && request.resource.data.recibido > resource.data.get('recibido', 0)
        && request.resource.data.recibido <= resource.data.cantidad + 100000
        && request.resource.data.donantes is list && request.resource.data.donantes.size() <= 60;
      allow delete: if request.auth != null && (id == request.auth.uid || id == request.auth.uid + '_t' || id == request.auth.uid + '_r');
    }

    // v6.84: regalos del dueño. Solo las cuentas del dueño (huellas SHA-256 de su correo, igual que HUELLAS_DUENO en datos.js)
    // pueden crearlos. El que lo recibe lo lee y lo borra al cobrarlo.
    function esDueno() {
      return request.auth != null && request.auth.token.email is string
        && (request.auth.token.email.lower() in ['maikelr@jugador.tinykingdom.app', 'maikelramirez55@jugador.tinykingdom.app'] ||
        hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
          '04ffb008e35525eb03d5dea75e79bb0d8217c5aab3a3a8953ed15953563508c4',
          'fd78fd09b2cd76c82a80675a4c758b65306b2309aaff68e598a4e344e7024bad',
          'bc81ce5c754b6d193233a82763f34d3c63953a8f9f05d9060e46d2a9111790e2']);
    }
    match /regalos/{id} {
      allow read: if request.auth != null && (resource.data.para == request.auth.uid || resource.data.de == request.auth.uid);
      allow create: if esDueno()
        && request.resource.data.keys().hasOnly(['de', 'deNombre', 'para', 'paraNombre', 'tropas', 'piezas', 'gemas', 'recursos', 'nota', 'fecha'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para is string && request.resource.data.para != request.auth.uid
        && request.resource.data.deNombre is string && request.resource.data.deNombre.size() <= 30
        && request.resource.data.paraNombre is string && request.resource.data.paraNombre.size() <= 30
        && request.resource.data.tropas is map && request.resource.data.tropas.size() <= 20
        && request.resource.data.piezas is list && request.resource.data.piezas.size() <= 30
        && request.resource.data.gemas is int && request.resource.data.gemas >= 0 && request.resource.data.gemas <= 1000000000000 // v7.94: hasta 1 billón
        && request.resource.data.recursos is map && request.resource.data.recursos.keys().hasOnly(['oro', 'comida', 'madera', 'piedra', 'hierro'])
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 120
        && request.resource.data.fecha is int;
      allow delete: if request.auth != null && (resource.data.para == request.auth.uid || esDueno());
    }

    // v7.07: SOPORTE. Cada jugador crea sus mensajes y lee solo los suyos; el dueño lee todos, responde y borra.
    match /soporte/{id} {
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || esDueno());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'nombre', 'tipo', 'texto', 'version', 'fecha', 'equipo'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 30
        && request.resource.data.tipo in ['error', 'pregunta', 'pago', 'jugador', 'otro']
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 600
        && request.resource.data.version is string && request.resource.data.version.size() <= 10
        && request.resource.data.equipo is string && request.resource.data.equipo.size() <= 80
        && request.resource.data.fecha is int;
      allow update: if esDueno()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuesta', 'respondido'])
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 600
        && request.resource.data.respondido is int;
      allow delete: if esDueno();
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
